  <data key="d11">1860</data>
  <data key="d12">1907</data>
  <data key="d13">Um 1860 wurde ihm eine Professur an der Accademia scientifico-letteraria zu Mailand angetragen, deren Zierde er bis an sein Lebensende geblieben ist.</data>
</edge>
<edge source="P:Hermann Paul" target="P:Wilhelm Braune" id="0">
  <data key="d9">collaborated_with</data>
  <data key="d10">Mitherausgeber</data>
  <data key="d11">0</data>
  <data key="d12">0</data>
  <data key="d13">in den ersten Bänden der von Hermann Paul und Wilhelm Braune herausgegebenen "Beiträge zur geschichte der deutschen sprache und literatur"</data>
</edge>
<edge source="P:Hermann Osthoff" target="I:Morphologische Untersuchungen auf dem Gebiete der indogermanischen Sprachen" id="0">
  <data key="d9">founded</data>
  <data key="d10"></data>
  <data key="d11">1878</data>
  <data key="d12">1881</data>
  <data key="d13">gründeten sie die "Morphologischen Untersuchungen auf dem Gebiete der indogermanischen Sprachen", von denen vier Teile erschienen sind, Leipzig 1878-1881.</data>
</edge>
<edge source="P:Georg Mahlow" target="P:Johannes Schmidt" id="0">
  <data key="d9">student_of</data>
  <data key="d10"></data>
  <data key="d11">0</data>
  <data key="d12">0</data>
  <data key="d13">Sein streitbarer Schüler Georg Mahlow hat die neuen Anschauungen auch für die langen Vokale durchgeführt</data>
</edge>
<edge source="P:Filipp Fortunatov" target="I:University of Moscow" id="0">
  <data key="d9">position_at</data>
  <data key="d10">Gelehrter</data>
  <data key="d11">0</data>
  <data key="d12">0</data>
  <data key="d13">Die kleine aber inhaltsreiche Abhandlung des Moskauer Gelehrten Ph. Fortunatov</data>
</edge>
<edge source="P:Wilhelm Heymann" target="I:University of Göttingen" id="0">
  <data key="d9">studied_at</data>
  <data key="d10"></data>
  <data key="d11">0</data>
  <data key="d12">1873</data>
  <data key="d13">in der Göttinger Dissertation "Das l der indogermanischen Sprachen gehört der indogermanischen Grundsprache an" von Wilhelm Heymann, Weimar 1873</data>
</edge>
<edge source="P:Arthur Amelung" target="I:University of Dorpat" id="0">
  <data key="d9">position_at</data>
  <data key="d10">Privatdozent</data>
  <data key="d11">1871</data>
  <data key="d12">1874</data>
  <data key="d13">habilitierte sich 1871 in Dorpat und ist bald darauf gestorben, am 6. April 1874.</data>
</edge>
<edge source="P:Arthur Amelung" target="I:University of Halle" id="0">
  <data key="d9">studied_at</data>
  <data key="d10"></data>
  <data key="d11">0</data>
  <data key="d12">1868</data>
  <data key="d13">Schon 1868 hatte er in Halle promoviert mit der Schrift "Prolegomena ad Ortnitum carmen theodiscum saeculi XIII".</data>
</edge>
<edge source="P:Giovanni Flechia" target="I:University of Turin" id="0">
  <data key="d9">position_at</data>
