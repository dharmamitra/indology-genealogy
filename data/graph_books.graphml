  <data key="d11">0</data>
  <data key="d12">0</data>
  <data key="d13">Zwar für den Buddhismus sah sich Lassen auf die Arbeiten von Hodgson, Burnouf und I. J. Schmidt angewiesen, S. 385 ff.</data>
</edge>
<edge source="P:Christian Lassen" target="I:University of Bonn" id="0">
  <data key="d9">position_at</data>
