  <data key="d9">influenced_by</data>
  <data key="d10"></data>
  <data key="d11">0</data>
  <data key="d12">0</data>
  <data key="d13">Als Sanskritphilologe stand er unter dem Einflusse Schlegels.</data>
</edge>
<edge source="P:Christian Lassen" target="P:Eugène Burnouf" id="0">
  <data key="d9">collaborated_with</data>
  <data key="d10"></data>
  <data key="d11">1826</data>
  <data key="d12">1826</data>
  <data key="d13">Burnouf und Lassen hatten im Essai sur le Pali S. 152 fg. diese Sprache als aus dem Sanskrit entstanden hingestellt</data>
</edge>
<edge source="P:Christian Lassen" target="P:Eugène Burnouf" id="1">
  <data key="d9">other</data>
  <data key="d10">friend</data>
  <data key="d11">1825</data>
  <data key="d12">0</data>
  <data key="d13">Während seines Aufenthalts in Paris im Jahre 1825 [...] schloß er die Freundschaft mit Eugène Burnouf.</data>
</edge>
<edge source="P:Christian Lassen" target="P:Eugène Burnouf" id="2">
  <data key="d9">influenced_by</data>
